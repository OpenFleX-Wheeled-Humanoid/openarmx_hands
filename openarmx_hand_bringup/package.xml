<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>openarmx_hand_bringup</name>
  <version>0.1.0</version>
  <description>Dual-mode bringup for OpenArmX bimanual arms with LinkerHand O6 hands.</description>
  <maintainer email="openarmrobot@gmail.com">OpenArmX</maintainer>
  <license>CC-BY-NC-SA-4.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>forward_command_controller</exec_depend>
  <exec_depend>hands_description</exec_depend>
  <exec_depend>hands_hardware</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>openarmx_description</exec_depend>
  <exec_depend>openarmx_gravity_comp</exec_depend>
  <exec_depend>openarmx_hand_description</exec_depend>
  <exec_depend>openarmx_hand_hardware</exec_depend>
  <exec_depend>openarmx_hardware</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
