<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>openarmx_hand_description</name>
  <version>0.1.0</version>
  <description>Composable OpenArmX bimanual description with LinkerHand O6 end effectors.</description>
  <maintainer email="openarmrobot@gmail.com">OpenArmX</maintainer>
  <license>CC-BY-NC-SA-4.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>hands_description</exec_depend>
  <exec_depend>openarmx_description</exec_depend>
  <exec_depend>openarmx_hand_hardware</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
