<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>openarmx_hand_hardware</name>
  <version>0.1.0</version>
  <description>Combined ros2_control hardware for an OpenArmX V10 arm and LinkerHand O6.</description>
  <maintainer email="openarmrobot@gmail.com">OpenArmX</maintainer>
  <license>CC-BY-NC-SA-4.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>openarmx_hardware</depend>
  <depend>openarmx_can</depend>
  <depend>hands_hardware</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
